<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <ProjectVersion>18.0</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <MainSource>CH341A_Tool.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Application</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(BCBPlatform)'=='True'">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(BCBPlatform)'=='True'">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Config)'=='Release') or ('$(Platform)'=='Win32' and '$(Config)'=='Release')">
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
    <SanitizedProjectName>CH341A_Tool</SanitizedProjectName>
    <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_E>false</DCC_E>
    <DCC_N>false</DCC_N>
    <DCC_S>false</DCC_S>
    <DCC_F>false</DCC_F>
    <DCC_K>false</DCC_K>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Config)'=='Debug') or ('$(Platform)'=='Win32' and '$(Config)'=='Debug')">
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
    <SanitizedProjectName>CH341A_Tool</SanitizedProjectName>
    <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_E>false</DCC_E>
    <DCC_N>false</DCC_N>
    <DCC_S>false</DCC_S>
    <DCC_F>false</DCC_F>
    <DCC_K>false</DCC_K>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Source\FormMain.pas"/>
    <DCCReference Include="Forms\FormAbout.pas"/>
    <DCCReference Include="Forms\FormSettings.pas"/>
    <DCCReference Include="Forms\LogUnit.pas"/>
    <DCCReference Include="Source\Settings.pas"/>
    <DCCReference Include="Source\Log.pas"/>
    <DCCReference Include="Lib\CH341DLL.pas"/>
    <BuildConfiguration Include="Release">
      <Key>$(BASE)\Release</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>$(BASE)\Debug</Key>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType/>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">CH341A_Tool.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
</Project>
